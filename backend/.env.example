PORT=3000

# Supabase - encontrás estos valores en:
# supabase.com → Voitos Database → Settings → API
SUPABASE_URL=https://pshejdspqqhuhyjbzslx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Destino de POST /api/sensor/dispensar: la IP del dispositivo en la red WiFi.
# La ESP32 la imprime por el monitor serie al conectarse ("IP: ...").
# Cambia cada vez que se conecta a otra red. Se puede pisar por request
# mandando "destino" en el body.
ESP32_URL=http://192.168.1.50

# Mails al cuidador (dispensacion OK y dosis no tomada).
# Si estas variables faltan, el backend NO falla: escribe los mails por consola
# en vez de enviarlos, asi se puede probar toda la logica sin mandar correos.
#
# Para Gmail hay que:
#   1. Crear la cuenta del proyecto (ej: voitos.pastillero@gmail.com)
#   2. Activar la verificacion en dos pasos en esa cuenta
#   3. Generar una "Contrasena de aplicacion" en
#      myaccount.google.com > Seguridad > Contrasenas de aplicaciones
#   4. Pegar esos 16 caracteres en MAIL_PASS (NO la password normal de la cuenta)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=voitos.pastillero@gmail.com
MAIL_PASS=la_contrasena_de_aplicacion_de_16_caracteres
MAIL_FROM=Voitos <voitos.pastillero@gmail.com>
