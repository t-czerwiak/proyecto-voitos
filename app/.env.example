# URL del backend de Voitos.
#
# Expo solo mete en el bundle del cliente las variables con prefijo
# EXPO_PUBLIC_, asi que el nombre tiene que ser exactamente este.
#
# Desarrollo (backend corriendo en la misma maquina):
EXPO_PUBLIC_API_URL=http://localhost:3000

# Desde el celular en la misma red WiFi, usar la IP de la computadora:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# En produccion, la URL del backend desplegado:
# EXPO_PUBLIC_API_URL=https://voitos-backend.onrender.com

# Client ID de Google, para el boton de "Continuar con Google".
#
# Es publico por diseno: identifica a la aplicacion, no autoriza nada. El que
# valida el token es el backend contra Google. Sale de Google Cloud Console,
# credencial OAuth 2.0 de tipo "Web application".
#
# Si no esta, el boton de Google no se dibuja y la app funciona igual.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
