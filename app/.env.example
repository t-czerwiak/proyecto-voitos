# URL del backend de Voitos.
#
# Expo solo mete en el bundle del cliente las variables con prefijo
# EXPO_PUBLIC_, asi que el nombre tiene que ser exactamente este.
#
# Desarrollo (backend corriendo en la misma maquina):
EXPO_PUBLIC_API_URL=http://localhost:3000

# Desde el celular en la misma red WiFi, usar la IP de la computadora:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# En produccion, la URL del backend desplegado:
# EXPO_PUBLIC_API_URL=https://voitos-backend.onrender.com
